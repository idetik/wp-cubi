# Autodetect text files
* text=auto

# Force the following filetypes to have unix eols, so Windows does not break them
*.php text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf

# Development only: left out of the deployment archive (RoboFile deploy = git archive, then rsync --delete:
# already deployed copies are removed from the servers)
/tests export-ignore
/docs export-ignore
/phpunit.xml.dist export-ignore
/phpunit-integration.xml.dist export-ignore
/phpstan.neon.dist export-ignore
/phpstan-baseline.neon export-ignore
/phpcs.xml export-ignore
/.gitlab-ci.yml export-ignore
/CLAUDE.md export-ignore
/.mcp.json export-ignore
/CONTRIBUTING.md export-ignore

{
    "name": "globalis/wp-cubi",
    "description": "WordPress modern stack for developers",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "repositories": {
        "idetik/webos": {
            "type": "vcs",
            "url": "https://github.com/idetik/burner-email-providers"
        },
        "11047703": {
            "type": "composer",
            "url": "https://gitlab.com/api/v4/group/11047703/-/packages/composer/",
            "exclude": [
                "idetik/coretik"
            ]
        },
        "wpackagist": {
            "type": "composer",
            "url": "https://wpackagist.org"
        }
    },
    "require": {
        "php": ">=8.4 <8.5",
        "composer/installers": "^2.3",
        "roots/wordpress": "^7.1",
        "globalis/wp-cli-bin": "^2.8",
        "globalis/wp-cubi-helpers": "^1.0",
        "globalis/wp-cubi-imagemin": "^1.3",
        "globalis/wp-unhooked": "^1.0.4",
        "globalis/wp-cubi-transient-cache": "^0.3.0",
        "johnbillion/extended-cpts": "^5.1",
        "roots/soil": "^4.1.1",
        "inpsyde/wonolog": "^3.0",
        "wpackagist-plugin/advanced-custom-fields": "^6.8",
        "johnbillion/query-monitor": "^4.0",
        "wpackagist-plugin/wp-crontrol": "^1.21",
        "wpackagist-plugin/user-switching": "^1.12",
        "wpackagist-plugin/autodescription": "^5.1",
        "wpackagist-plugin/limit-login-attempts-reloaded": "^3.3",
        "wpackagist-plugin/two-factor": "^0.16.0",
        "idetik/acf-extended-pro": "^0.9.27",
        "idetik/coretik": "^2.0@beta",
        "stoutlogic/acf-builder": "^1.12",
        "idetik/service-acf-composer": "^1.3",
        "idetik/coretik-navigation": "^1.1",
        "idetik/coretik-page-builder": "^2.5.4",
        "idetik/starter": "^1.2",
        "sentry/sentry": "^4.10"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7.2",
        "consolidation/robo": "5.1.0",
        "globalis/wp-cubi-robo": "^2.5.2",
        "idetik/robo-build-assets-npm": "^1.0",
        "idetik/robo-generate-blocks-thumbnail": "^2.0",
        "daandesmedt/phpheadlesschrome": "^1.1",
        "idetik/coretik-faker": "^1.0",
        "idetik/robo-release": "^1.0",
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.1",
        "yoast/phpunit-polyfills": "^4.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4",
        "symfony/console": "^6.4",
        "php-stubs/wp-cli-stubs": "^2.11"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "MyNamespace\\": "web/app/themes/starter/src/"
        }
    },
    "extra": {
        "installer-paths": {
            "web/app/mu-modules/{$name}/": [
                "type:wordpress-muplugin"
            ],
            "web/app/modules/{$name}/": [
                "type:wordpress-plugin"
            ],
            "web/app/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        },
        "wordpress-install-dir": "web/wpcb"
    },
    "suggest": {
        "globalis/wp-cubi-robo-globalis": "Provides a BuildAssets trait for RoboFile"
    },
    "scripts": {
        "post-create-project-cmd": [
            "@clean"
        ],
        "clean": [
            "chmod 777 log",
            "chmod 777 web/media",
            "rm -rf .git .resources LICENSE.md README.md",
            "rm -rf web/app/themes/starter/.gitlab-ci.yml",
            "rm -rf web/app/themes/starter/.releaserc.json",
            "rm -rf web/app/themes/starter/CHANGELOG.md",
            "rm -rf web/app/themes/starter/composer.json",
            "rm -rf web/app/themes/starter/composer.lock",
            "npm remove semantic-release --prefix web/app/themes/starter",
            "npm remove @semantic-release/changelog --prefix web/app/themes/starter",
            "npm remove @semantic-release/git --prefix web/app/themes/starter",
            "npm remove @semantic-release/gitlab --prefix web/app/themes/starter",
            "npm remove @semantic-release/release-notes-generator --prefix web/app/themes/starter",
            "@php vendor/bin/robo project:init"
        ],
        "post-install-cmd": [
            "@git-hooks"
        ],
        "post-update-cmd": [
            "@git-hooks"
        ],
        "git-hooks": "git rev-parse --git-dir > /dev/null 2>&1 && git config core.hooksPath vendor/idetik/robo-release/hooks || true",
        "test": "phpunit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "test:db": [
            "docker start coretik-tests-mysql > /dev/null 2>&1 || docker run -d --name coretik-tests-mysql -e MYSQL_ROOT_PASSWORD=root -p 3307:3306 --tmpfs /var/lib/mysql mysql:8.4",
            "for i in $(seq 60); do docker exec coretik-tests-mysql mysql -uroot -proot -e \"CREATE DATABASE IF NOT EXISTS ${WP_TESTS_DB_NAME:-wp_cubi_tests}\" 2> /dev/null && exit 0; sleep 1; done; echo \"MySQL is not ready\" && exit 1"
        ],
        "analyse": "phpstan analyse --memory-limit=2G",
        "lint": "phpcs"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "roots/wordpress-core-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
